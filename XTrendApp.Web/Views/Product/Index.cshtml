@model XTrendApp.Web.Models.Product.ProductListPageViewModel

@{
    ViewData["Title"] = "Products";

    var sortBy =
        ViewBag.SortBy as string ?? "LastScan";

    var sortDirection =
        ViewBag.SortDirection as string ?? "desc";
}


<div class="page-header d-print-none mb-3">

    <div class="container-xl">

        <div class="row align-items-center">

            <div class="col">

                <h2 class="page-title">
                    Products
                </h2>

                <div class="text-secondary mt-1">
                    Track product collections and their performance
                </div>

            </div>

        </div>

    </div>

</div>


<div class="page-body">

    <div class="container-xl">

        <div class="card">


            <!-- CARD HEADER -->

            <div class="card-header">

                <h3 class="card-title">
                    Product Collections
                </h3>


                <div class="card-actions">

                    <span class="text-secondary">

                        @Model.TotalCount
                        @(Model.TotalCount == 1 ? "product" : "products")

                    </span>

                </div>

            </div>


            <!-- TABLE -->

            <div class="table-responsive">

                <table class="table table-vcenter table-hover">

                    <thead>

                        <tr>


                            <!-- IMAGE -->

                            <th style="width: 72px;"></th>


                            <!-- PRODUCT -->

                            <th>

                                <a href="@Url.Action("Index", new
                                   {
                                       sortBy = "Product",

                                       sortDirection =
                                                                           sortBy.Equals(
                                                                               "Product",
                                                                               StringComparison.OrdinalIgnoreCase)
                                                                           &&
                                                                           sortDirection.Equals(
                                                                               "asc",
                                                                               StringComparison.OrdinalIgnoreCase)
                                                                               ? "desc"
                                                                               : "asc",

                                       page = 1,

                                       pageSize = Model.PageSize
                                   })"
                                   class="table-sort-link">

                                    Product

                                    @if (sortBy.Equals(
                                                                        "Product",
                                                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <i class="ti ti-chevron-@(sortDirection.Equals(
                                                                                       "asc",
                                                                                       StringComparison.OrdinalIgnoreCase)
                                                                                       ? "up"
                                                                                       : "down")"></i>
                                                                        }

                                </a>

                            </th>


                            <!-- BRAND -->

                            <th>

                                <a href="@Url.Action("Index", new
                                   {
                                       sortBy = "Brand",

                                       sortDirection =
                                                                           sortBy.Equals(
                                                                               "Brand",
                                                                               StringComparison.OrdinalIgnoreCase)
                                                                           &&
                                                                           sortDirection.Equals(
                                                                               "asc",
                                                                               StringComparison.OrdinalIgnoreCase)
                                                                               ? "desc"
                                                                               : "asc",

                                       page = 1,

                                       pageSize = Model.PageSize
                                   })"
                                   class="table-sort-link">

                                    Brand

                                    @if (sortBy.Equals(
                                                                        "Brand",
                                                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <i class="ti ti-chevron-@(sortDirection.Equals(
                                                                                       "asc",
                                                                                       StringComparison.OrdinalIgnoreCase)
                                                                                       ? "up"
                                                                                       : "down")"></i>
                                                                        }

                                </a>

                            </th>


                            <!-- MARKETPLACE -->

                            <th>

                                <a href="@Url.Action("Index", new
                                   {
                                       sortBy = "Marketplace",

                                       sortDirection =
                                                                           sortBy.Equals(
                                                                               "Marketplace",
                                                                               StringComparison.OrdinalIgnoreCase)
                                                                           &&
                                                                           sortDirection.Equals(
                                                                               "asc",
                                                                               StringComparison.OrdinalIgnoreCase)
                                                                               ? "desc"
                                                                               : "asc",

                                       page = 1,

                                       pageSize = Model.PageSize
                                   })"
                                   class="table-sort-link">

                                    Marketplace

                                    @if (sortBy.Equals(
                                                                        "Marketplace",
                                                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <i class="ti ti-chevron-@(sortDirection.Equals(
                                                                                       "asc",
                                                                                       StringComparison.OrdinalIgnoreCase)
                                                                                       ? "up"
                                                                                       : "down")"></i>
                                                                        }

                                </a>

                            </th>


                            <!-- VARIATIONS -->

                            <th class="text-center">

                                <a href="@Url.Action("Index", new
                                   {
                                       sortBy = "Variations",

                                       sortDirection =
                                                                           sortBy.Equals(
                                                                               "Variations",
                                                                               StringComparison.OrdinalIgnoreCase)
                                                                           &&
                                                                           sortDirection.Equals(
                                                                               "asc",
                                                                               StringComparison.OrdinalIgnoreCase)
                                                                               ? "desc"
                                                                               : "asc",

                                       page = 1,

                                       pageSize = Model.PageSize
                                   })"
                                   class="table-sort-link justify-content-center">

                                    Variations

                                    @if (sortBy.Equals(
                                                                        "Variations",
                                                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <i class="ti ti-chevron-@(sortDirection.Equals(
                                                                                       "asc",
                                                                                       StringComparison.OrdinalIgnoreCase)
                                                                                       ? "up"
                                                                                       : "down")"></i>
                                                                        }

                                </a>

                            </th>


                            <!-- RATING -->

                            <th class="text-center">

                                <a href="@Url.Action("Index", new
                                   {
                                       sortBy = "Rating",

                                       sortDirection =
                                                                           sortBy.Equals(
                                                                               "Rating",
                                                                               StringComparison.OrdinalIgnoreCase)
                                                                           &&
                                                                           sortDirection.Equals(
                                                                               "asc",
                                                                               StringComparison.OrdinalIgnoreCase)
                                                                               ? "desc"
                                                                               : "asc",

                                       page = 1,

                                       pageSize = Model.PageSize
                                   })"
                                   class="table-sort-link justify-content-center">

                                    Rating

                                    @if (sortBy.Equals(
                                                                        "Rating",
                                                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <i class="ti ti-chevron-@(sortDirection.Equals(
                                                                                       "asc",
                                                                                       StringComparison.OrdinalIgnoreCase)
                                                                                       ? "up"
                                                                                       : "down")"></i>
                                                                        }

                                </a>

                            </th>


                            <!-- REVIEWS -->

                            <th class="text-end">

                                <a href="@Url.Action("Index", new
                                   {
                                       sortBy = "Reviews",

                                       sortDirection =
                                                                           sortBy.Equals(
                                                                               "Reviews",
                                                                               StringComparison.OrdinalIgnoreCase)
                                                                           &&
                                                                           sortDirection.Equals(
                                                                               "asc",
                                                                               StringComparison.OrdinalIgnoreCase)
                                                                               ? "desc"
                                                                               : "asc",

                                       page = 1,

                                       pageSize = Model.PageSize
                                   })"
                                   class="table-sort-link justify-content-end">

                                    Reviews

                                    @if (sortBy.Equals(
                                                                        "Reviews",
                                                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <i class="ti ti-chevron-@(sortDirection.Equals(
                                                                                       "asc",
                                                                                       StringComparison.OrdinalIgnoreCase)
                                                                                       ? "up"
                                                                                       : "down")"></i>
                                                                        }

                                </a>

                            </th>


                            <!-- LAST SCAN -->

                            <th>

                                <a href="@Url.Action("Index", new
                                   {
                                       sortBy = "LastScan",

                                       sortDirection =
                                                                           sortBy.Equals(
                                                                               "LastScan",
                                                                               StringComparison.OrdinalIgnoreCase)
                                                                           &&
                                                                           sortDirection.Equals(
                                                                               "asc",
                                                                               StringComparison.OrdinalIgnoreCase)
                                                                               ? "desc"
                                                                               : "asc",

                                       page = 1,

                                       pageSize = Model.PageSize
                                   })"
                                   class="table-sort-link">

                                    Last Scan

                                    @if (sortBy.Equals(
                                                                        "LastScan",
                                                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <i class="ti ti-chevron-@(sortDirection.Equals(
                                                                                       "asc",
                                                                                       StringComparison.OrdinalIgnoreCase)
                                                                                       ? "up"
                                                                                       : "down")"></i>
                                                                        }

                                </a>

                            </th>


                            <!-- ACTION -->

                            <th style="width: 50px;"></th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model.Products)
                        {
                            <tr>


                                <!-- IMAGE -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <span class="avatar avatar-md rounded"
                                              style="background-image: url('@item.ImageUrl');">
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="avatar avatar-md rounded bg-secondary-lt">

                                            <i class="ti ti-photo fs-2 text-secondary"></i>

                                        </span>
                                    }

                            </td>


                            <!-- PRODUCT -->

                            <td>

                                <div class="d-flex flex-column">

                                    <a href="/Product/Detail/@item.Id"
                                       class="text-reset fw-semibold product-name"
                                       title="@item.Name">

                                        @item.Name

                                    </a>

                                    <div class="text-secondary small mt-1">

                                        @item.VariationCount

                                        @(item.VariationCount == 1
                                                                                ? "variation"
                                                                                : "variations")

                                    </div>

                                    </div>

                                </td>


                                <!-- BRAND -->

                                <td>

                                @if (!string.IsNullOrWhiteSpace(item.Brand))
                                    {
                                        <span class="fw-medium">
                                            @item.Brand
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">
                                            N/A
                                        </span>
                                    }

                                </td>


                                <!-- MARKETPLACE -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.Source))
                                    {
                                        <div class="d-flex align-items-center gap-2">

                                            <span class="avatar avatar-xs">

                                                <i class="ti ti-shopping-cart"></i>

                                            </span>

                                            <span>
                                                @item.Source
                                            </span>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">
                                            N/A
                                        </span>
                                    }

                                </td>


                                <!-- VARIATIONS -->

                                <td class="text-center">

                                    <span class="badge bg-yellow-lt">

                                        @item.VariationCount

                                    </span>

                                </td>


                                <!-- RATING -->

                                <td class="text-center">

                                    @if (item.Rating.HasValue)
                                    {
                                        <span class="text-nowrap">

                                            <span class="text-yellow">
                                                ★
                                            </span>

                                            <span class="fw-medium">

                                                @item.Rating.Value.ToString("0.0")

                                            </span>

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">
                                            N/A
                                        </span>
                                    }

                                </td>


                                <!-- REVIEWS -->

                                <td class="text-end">

                                    @if (item.ReviewCount.HasValue)
                                    {
                                        <span class="fw-medium">

                                            @item.ReviewCount.Value.ToString("N0")

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">
                                            N/A
                                        </span>
                                    }

                                </td>


                                <!-- LAST SCAN -->

                                <td>

                                    @if (item.LastCapturedAt.HasValue)
                                    {
                                        <div class="d-flex flex-column">

                                            <span class="fw-medium">

                                                @item.LastCapturedAt.Value.ToString("dd.MM.yyyy")

                                            </span>

                                            <span class="text-secondary small">

                                                @item.LastCapturedAt.Value.ToString("HH:mm")

                                            </span>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">
                                            N/A
                                        </span>
                                    }

                                </td>


                                <!-- ACTION -->

                                <td>

                                    <a href="/Product/Detail/@item.Id"
                                       class="btn btn-ghost-secondary btn-icon"
                                       title="View product">

                                        <i class="ti ti-chevron-right"></i>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- PAGINATION -->
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer">

                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">


                        <!-- RESULT INFO -->

                        <div class="text-secondary">

                            @{

                                var firstItem =
                                ((Model.Page - 1) * Model.PageSize) + 1;

                                var lastItem =
                                Math.Min(
                                Model.Page * Model.PageSize,
                                Model.TotalCount);

                            }

                            Showing

                            <strong>
                                @firstItem
                            </strong>

                            to

                            <strong>
                                @lastItem
                            </strong>

                            of

                            <strong>
                                @Model.TotalCount
                            </strong>

                            products

                        </div>


                        <!-- PAGINATION -->

                        <ul class="pagination mb-0">


                            <!-- PREVIOUS -->

                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">

                                @if (Model.HasPreviousPage)
                                {
                                    <a class="page-link"
                                       href="@Url.Action("Index", new
                                       {
                                           page = Model.Page - 1,
                                           pageSize = Model.PageSize,
                                           sortBy = sortBy,
                                           sortDirection = sortDirection
                                       })">

                                <i class="ti ti-chevron-left"></i>

                                        Previous

                                    </a>
                                                        }
                                else
                                {
                                    <span class="page-link">

                                        <i class="ti ti-chevron-left"></i>

                                        Previous

                                    </span>
                                }

                            </li>


                            <!-- PAGE NUMBERS -->
                            @for (var i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.Page ? "active" : "")">

                                    <a class="page-link"
                                       href="@Url.Action("Index", new
                                       {
                                           page = i,
                                           pageSize = Model.PageSize,
                                           sortBy = sortBy,
                                           sortDirection = sortDirection
                                       })">

                                @i

                                    </a>

                                </li>
                                                }


                            <!-- NEXT -->

                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">

                                @if (Model.HasNextPage)
                                {
                                    <a class="page-link"
                                       href="@Url.Action("Index", new
                                       {
                                           page = Model.Page + 1,
                                           pageSize = Model.PageSize,
                                           sortBy = sortBy,
                                           sortDirection = sortDirection
                                       })">

                                Next

                                        <i class="ti ti-chevron-right"></i>

                                    </a>
                                                        }
                                else
                                {
                                    <span class="page-link">

                                        Next

                                        <i class="ti ti-chevron-right"></i>

                                    </span>
                                }

                            </li>

                        </ul>

                    </div>

                </div>
            }


        </div>

    </div>

</div>


<style>

    .product-name {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.35;
        max-width: 520px;
    }


    .table td {
        vertical-align: middle;
    }


    .table-sort-link {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        color: inherit;
        text-decoration: none;
    }


        .table-sort-link:hover {
            color: var(--tblr-primary);
        }


        .table-sort-link i {
            font-size: 0.9rem;
        }

</style>